          "type": "object",
          "required": ["armature", "slip_table", "drive_adapter", "fixturing", "test_article"],
          "additionalProperties": false,
          "properties": {
            "armature": {"type": "number", "minimum": 0},
            "slip_table": {"type": "number", "minimum": 0},
            "drive_adapter": {"type": "number", "minimum": 0},
            "fixturing": {"type": "number", "minimum": 0},
            "test_article": {"type": "number", "minimum": 0}
          }
        },
        "crest_factor": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "randomConfig": {
      "type": "object", "required": ["title", "profile", "acquisition", "schedule"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "profile": {"$ref": "#/$defs/profile"},
        "acquisition": {"$ref": "#/$defs/acquisition"},
        "schedule": {"$ref": "#/$defs/schedule"},
        "control": {"$ref": "#/$defs/controlParams"},
        "limits": {"type": "array", "items": {"$ref": "#/$defs/limitProfile"}},
        "feasibility": {"$ref": "#/$defs/feasibilityInputs"}
      }
    },
    "randomConfigureParams": {
      "type": "object", "required": ["config"], "additionalProperties": false,
      "properties": {"config": {"$ref": "#/$defs/randomConfig"}, "dry_run": {"type": "boolean"}}
    },
    "grid": {
      "type": ["object", "null"], "required": ["fs_hz", "n_pts", "df_hz", "lines", "loop_s", "actual"],
      "additionalProperties": false,
      "properties": {
        "fs_hz": {"type": "number", "exclusiveMinimum": 0},
        "n_pts": {"type": "integer", "minimum": 1},
        "df_hz": {"type": "number", "exclusiveMinimum": 0},
        "lines": {"type": "integer", "minimum": 0},
        "loop_s": {"type": "number", "exclusiveMinimum": 0},
        "actual": {"type": "boolean"}
      }
    },
    "derived": {
      "type": "object",
      "required": ["grms_g", "velocity_rms_ips", "displacement_rms_mil", "band_hz", "grid", "control_channels"],
      "additionalProperties": false,
      "properties": {
        "grms_g": {"type": "number", "minimum": 0},
        "velocity_rms_ips": {"type": "number", "minimum": 0},
        "displacement_rms_mil": {"type": "number", "minimum": 0},
        "band_hz": {
          "type": "array", "minItems": 2,
          "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false
        },
        "grid": {"$ref": "#/$defs/grid", "type": "object"},
        "control_channels": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "randomConfigureResult": {
      "type": "object", "required": ["state", "derived", "warnings"], "additionalProperties": false,
      "properties": {
        "state": {"$ref": "#/$defs/randomState"},
        "derived": {"$ref": "#/$defs/derived"},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/reportItem"}}
      }
    },
    "randomDryRunResult": {
      "type": "object", "required": ["errors", "warnings", "derived", "views"], "additionalProperties": false,
      "properties": {
        "errors": {"type": "array", "items": {"$ref": "#/$defs/reportItem"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/reportItem"}},
        "derived": {"oneOf": [{"$ref": "#/$defs/derived"}, {"type": "null"}]},
        "views": {"$ref": "#/$defs/referenceViews"}
      }
    },
    "referenceViews": {
      "type": "array", "items": {"$ref": "#/$defs/spectrumView"}
    },
    "randomConfigResult": {
      "type": "object", "required": ["run_id", "config", "derived", "views"], "additionalProperties": false,
      "properties": {
        "run_id": {"type": ["string", "null"]},
        "config": {"oneOf": [{"$ref": "#/$defs/randomConfig"}, {"type": "null"}]},
        "derived": {"oneOf": [{"$ref": "#/$defs/derived"}, {"type": "null"}]},
        "views": {"$ref": "#/$defs/referenceViews"}
      }
    },
    "randomArmParams": {
      "type": "object", "additionalProperties": false,
      "properties": {"override_ack": {"type": "string", "minLength": 1}}
    },
    "randomLevelParams": {
      "type": "object", "additionalProperties": false,
      "properties": {"delta_db": {"type": "number"}, "to_db": {"type": "number"}},
      "oneOf": [{"required": ["delta_db"]}, {"required": ["to_db"]}]
    },
    "randomLevelResult": {
      "type": "object", "required": ["level_db"], "additionalProperties": false,
      "properties": {"level_db": {"type": "number"}}
    },
    "randomModeParams": {
      "type": "object", "required": ["mode"], "additionalProperties": false,
      "properties": {"mode": {"enum": ["auto", "manual"]}}
    },
    "randomLogParams": {
      "type": "object", "additionalProperties": false,
      "properties": {"since": {"type": "integer", "minimum": 0}}
    },
    "runState": {"enum": ["unconfigured", "configured", "blocked", "armed", "running", "review", "stopping", "finished"]},
    "runPhase": {
      "enum": ["idle", "feasibility_blocked", "armed", "sysid", "coherence_gate", "engaged", "full_level",
               "awaiting_review", "ramping_down", "stopped", "aborted", "coherence_hold"]
    },
    "stationRef": {
      "type": ["object", "null"], "required": ["kind", "class", "devices"], "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["sim", "ni"]},
        "class": {"$ref": "#/$defs/stationClass"},
        "devices": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "serial"], "additionalProperties": false,
            "properties": {"id": {"type": "string", "minLength": 1}, "serial": {"type": "string"}}
          }
        }
      }
    },
    "trip": {
      "type": "object", "required": ["kind", "at_level_db", "at_loop"],
      "properties": {
        "kind": {"enum": ["envelope", "kinematic", "drive_vrms", "divergence"]},
        "at_level_db": {"type": "number"},
        "at_loop": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "envelope"}, "abort_lines": {"type": "integer", "minimum": 0}, "worst_db": {"type": "number"}},
         "required": ["abort_lines", "worst_db"]},
        {"properties": {"kind": {"const": "kinematic"}, "channel": {"type": "integer", "minimum": 0},
                        "axis": {"enum": ["accel", "velocity", "displacement"]},
                        "value": {"type": "number"}, "limit": {"type": "number"}},
         "required": ["channel", "axis", "value", "limit"]},
        {"properties": {"kind": {"const": "drive_vrms"}, "realized_vrms": {"type": "number"}, "limit_vrms": {"type": "number"}},
         "required": ["realized_vrms", "limit_vrms"]},
        {"properties": {"kind": {"const": "divergence"}, "consecutive_loops": {"type": "integer", "minimum": 0},
                        "divergent_bins": {"type": "integer", "minimum": 0}},
         "required": ["consecutive_loops", "divergent_bins"]}
      ]
    },
    "runEnd": {
      "type": ["object", "null"], "required": ["outcome", "message", "at_s", "level_db", "trip"],
      "additionalProperties": false,
      "properties": {
        "outcome": {"enum": ["completed", "operator_stop", "operator_abort", "safe_stop", "aborted", "held", "sysid_level_unreachable", "fault"]},
        "message": {"type": "string", "minLength": 1},
        "at_s": {"type": ["number", "null"], "minimum": 0},
        "level_db": {"type": ["number", "null"]},
        "trip": {"oneOf": [{"$ref": "#/$defs/trip"}, {"type": "null"}]}
      },
      "if": {"type": "object", "properties": {"outcome": {"const": "aborted"}}},
      "then": {"properties": {"trip": {"type": "object"}}},
      "else": {"properties": {"trip": {"type": "null"}}}
    },
    "feasibilityVerdict": {
      "type": ["object", "null"], "required": ["verdict", "message"], "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["pass", "advisory", "exceeded", "not_evaluated"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "randomState": {
      "type": "object",
      "required": ["run_id", "state", "phase", "title", "source", "station", "grid", "clock", "mode",
                   "levels_db", "level_db", "full_level_s", "elapsed_s", "at_level_s",
                   "remaining_at_level_s", "alarm", "feasibility", "end"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": ["string", "null"]},
        "state": {"$ref": "#/$defs/runState"},
        "phase": {"$ref": "#/$defs/runPhase"},
        "title": {"type": ["string", "null"]},
        "source": {"oneOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]},
        "station": {"$ref": "#/$defs/stationRef"},
        "grid": {"$ref": "#/$defs/grid"},
        "clock": {"enum": ["shared", "independent", "unknown", null]},
        "mode": {"enum": ["auto", "manual", null]},
        "levels_db": {"type": ["array", "null"], "items": {"type": "number"}},
        "level_db": {"type": ["number", "null"]},
        "full_level_s": {"type": ["number", "null"], "minimum": 0},
        "elapsed_s": {"type": ["number", "null"], "minimum": 0},
        "at_level_s": {"type": ["number", "null"], "minimum": 0},
        "remaining_at_level_s": {"type": ["number", "null"], "minimum": 0},
        "alarm": {"type": "boolean"},
        "feasibility": {"$ref": "#/$defs/feasibilityVerdict"},
        "end": {"$ref": "#/$defs/runEnd"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "finished"}}},
         "then": {"properties": {"end": {"type": "object"}}},
         "else": {"properties": {"end": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "unconfigured"}}},
         "then": {"properties": {"run_id": {"type": "null"}}},
         "else": {"properties": {"run_id": {"type": "string"}, "source": {"$ref": "#/$defs/source"}}}},
        {"if": {"required": ["station"], "properties": {"station": {"type": "object", "required": ["class"],
                                                                   "properties": {"class": {"const": "ni_real"}}}}},
         "then": {"properties": {"source": {"const": "HARDWARE"}}},
         "else": {"properties": {"source": {"enum": ["SIM", null]}}}}
      ]
    },
    "liveChannel": {
      "type": "object", "required": ["index", "description", "role", "rms", "unit", "overload"],
      "additionalProperties": false,
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "description": {"type": "string"},
        "role": {"enum": ["control", "monitor", "reference"]},
        "rms": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "overload": {"type": "boolean"}
      }
    },
    "alarm": {
      "oneOf": [
        {"type": "object", "required": ["kind", "lines", "worst_db"], "additionalProperties": false,
         "properties": {"kind": {"const": "envelope"}, "lines": {"type": "integer", "minimum": 1}, "worst_db": {"type": "number"}}},
        {"type": "object", "required": ["kind", "channel"], "additionalProperties": false,
         "properties": {"kind": {"const": "overload"}, "channel": {"type": "integer", "minimum": 0}}}
      ]
    },
    "randomLive": {
      "type": "object",
      "required": ["run_id", "source", "class", "state", "phase", "mode", "elapsed_s", "level_db",
                   "commanded_db", "at_level_s", "remaining_at_level_s", "level_s", "loop",
                   "control_rms_g", "reference_rms_g", "control_error_db", "drive_rms_v", "lines",
                   "channels", "alarms", "views"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "class": {"$ref": "#/$defs/stationClass"},
        "state": {"enum": ["running", "review", "stopping", "finished"]},
        "phase": {"$ref": "#/$defs/runPhase"},
        "mode": {"enum": ["auto", "manual"]},
        "elapsed_s": {"type": "number", "minimum": 0},
        "level_db": {"type": ["number", "null"]},
        "commanded_db": {"type": ["number", "null"]},
        "at_level_s": {"type": ["number", "null"], "minimum": 0},
        "remaining_at_level_s": {"type": ["number", "null"], "minimum": 0},
        "level_s": {"type": ["number", "null"], "minimum": 0},
        "loop": {"type": "integer", "minimum": 0},
        "control_rms_g": {"type": ["number", "null"], "minimum": 0},
        "reference_rms_g": {"type": ["number", "null"], "minimum": 0},
        "control_error_db": {"type": ["number", "null"]},
        "drive_rms_v": {"type": ["number", "null"], "minimum": 0},
        "lines": {
          "type": "object", "required": ["in_band", "alarm", "abort"], "additionalProperties": false,
          "properties": {
            "in_band": {"type": "integer", "minimum": 0},
            "alarm": {"type": "integer", "minimum": 0},
            "abort": {"type": "integer", "minimum": 0}
          }
        },
        "channels": {"type": "array", "items": {"$ref": "#/$defs/liveChannel"}},
        "alarms": {"type": "array", "items": {"$ref": "#/$defs/alarm"}},
        "views": {
          "type": "array", "minItems": 3,
