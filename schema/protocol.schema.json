{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sds/1",
  "title": "Suite protocol sds/1 (decoded messages; arrays shown as {\"$array\": id} before decoding)",
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/event"}
  ],
  "$defs": {
    "arrayRef": {
      "type": "object", "required": ["$array"], "additionalProperties": false,
      "properties": {"$array": {"type": "string"}}
    },
    "arrayEntry": {
      "type": "object", "required": ["id", "dtype", "shape", "offset", "nbytes"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "dtype": {"enum": ["f32", "f64", "i32", "u32", "u8"]},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "offset": {"type": "integer", "minimum": 0, "multipleOf": 8},
        "nbytes": {"type": "integer", "minimum": 0}
      }
    },
    "arrays": {"type": "array", "items": {"$ref": "#/$defs/arrayEntry"}},
    "hello": {
      "type": "object", "required": ["type", "protocol", "service", "version"],
      "properties": {
        "type": {"const": "hello"},
        "protocol": {"const": "sds/1"},
        "service": {"enum": ["analysis", "control"]},
        "version": {"type": "string"}
      }
    },
    "request": {
      "type": "object", "required": ["type", "id", "method", "params"],
      "properties": {
        "type": {"const": "request"},
        "id": {"type": "integer"},
        "method": {"type": "string"},
        "params": {"type": "object"},
        "arrays": {"$ref": "#/$defs/arrays"}
      }
    },
    "response": {
      "type": "object", "required": ["type", "id"],
      "properties": {
        "type": {"const": "response"},
        "id": {"type": "integer"},
        "result": {"type": "object"},
        "error": {
          "type": "object", "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["bad_request", "unknown_method", "not_found", "refused", "internal"]},
            "message": {"type": "string", "minLength": 1},
            "reason": {"$ref": "#/$defs/reason"},
            "detail": {"type": "object"}
          }
        },
        "arrays": {"$ref": "#/$defs/arrays"}
      },
      "oneOf": [{"required": ["result"]}, {"required": ["error"]}]
    },
    "event": {
      "type": "object", "required": ["type", "topic", "seq", "data"],
      "properties": {
        "type": {"const": "event"},
        "topic": {"type": "string"},
        "seq": {"type": "integer", "minimum": 0},
        "data": {"type": "object"},
        "arrays": {"$ref": "#/$defs/arrays"}
      }
    },
    "axis": {
      "type": "object", "required": ["label", "unit", "scale"],
      "properties": {
        "label": {"type": "string"},
        "unit": {"type": ["string", "null"]},
        "scale": {"enum": ["log", "linear"]}
      }
    },
    "series": {
      "type": "object", "required": ["name", "role", "x", "y"],
      "properties": {
        "name": {"type": "string"},
        "role": {"enum": ["measured", "reference", "tolerance", "abort", "limit", "drive", "other"]},
        "x": {"$ref": "#/$defs/arrayRef"},
        "y": {"$ref": "#/$defs/arrayRef"},
        "shape": {"enum": ["line", "steps", "law"]},
        "edges": {"$ref": "#/$defs/arrayRef"},
        "follows": {"type": "integer", "minimum": 0}
      },
      "if": {"required": ["shape"], "properties": {"shape": {"const": "steps"}}},
      "then": {"required": ["edges"]}
    },
    "spectrumView": {
      "type": "object", "required": ["view", "title", "x", "y", "series"],
      "properties": {
        "view": {"const": "spectrum"},
        "title": {"type": "string"},
        "x": {"$ref": "#/$defs/axis"},
        "y": {"$ref": "#/$defs/axis"},
        "series": {"type": "array", "items": {"$ref": "#/$defs/series"}},
        "link": {"type": "string"}
      }
    },
    "readingView": {
      "type": "object", "required": ["view", "title", "rows"],
      "properties": {
        "view": {"const": "reading"},
        "title": {"type": "string"},
        "rows": {
          "type": "array",
          "items": {
            "type": "object", "required": ["label", "value", "status"],
            "properties": {
              "label": {"type": "string"},
              "value": {"type": ["number", "string"]},
              "unit": {"type": ["string", "null"]},
              "status": {"enum": ["pass", "warn", "fail", "info"]}
            }
          }
        }
      }
    },
    "mode": {
      "type": "object", "required": ["index", "frequency_hz", "shape"],
      "properties": {
        "index": {"type": "integer"},
        "frequency_hz": {"type": "number"},
        "damping": {"type": ["number", "null"]},
        "shape": {"$ref": "#/$defs/arrayRef"},
        "shape_imag": {"$ref": "#/$defs/arrayRef"},
        "label": {"type": "string"}
      }
    },
    "shape3dView": {
      "type": "object", "required": ["view", "title", "unit", "nodes", "modes"],
      "properties": {
        "view": {"const": "shape3d"},
        "title": {"type": "string"},
        "unit": {"type": "string"},
        "nodes": {"$ref": "#/$defs/arrayRef"},
        "lines": {"$ref": "#/$defs/arrayRef"},
        "triangles": {"$ref": "#/$defs/arrayRef"},
        "modes": {"type": "array", "items": {"$ref": "#/$defs/mode"}},
        "overlays": {"type": "array", "items": {"$ref": "#/$defs/mode"}},
        "overlay_phase": {"$ref": "#/$defs/arrayRef"},
        "link": {"type": "string"},
        "motion": {
          "type": "object",
          "required": ["label", "unit", "start", "step", "quantity", "value_unit", "node", "direction", "values", "peak"],
          "properties": {
            "label": {"type": "string"},
            "unit": {"type": "string"},
            "start": {"type": "number"},
            "step": {"type": "number"},
            "quantity": {"type": "string"},
            "value_unit": {"type": "string"},
            "node": {"$ref": "#/$defs/arrayRef"},
            "direction": {"$ref": "#/$defs/arrayRef"},
            "values": {"$ref": "#/$defs/arrayRef"},
            "peak": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "matrixView": {
      "type": "object",
      "required": ["view", "title", "rows", "columns", "values", "value_label", "value_range"],
      "properties": {
        "view": {"const": "matrix"},
        "title": {"type": "string"},
        "rows": {"$ref": "#/$defs/matrixAxis"},
        "columns": {"$ref": "#/$defs/matrixAxis"},
        "values": {"$ref": "#/$defs/arrayRef"},
        "value_label": {"type": "string"},
        "value_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "selects": {"const": "shape3d"}
      }
    },
    "matrixAxis": {
      "type": "object", "required": ["label", "ticks"],
      "properties": {
        "label": {"type": "string"},
        "ticks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "waterfallView": {
      "type": "object",
      "required": ["view", "title", "x", "z", "records", "offsets", "x_values", "z_values", "x_range"],
      "properties": {
        "view": {"const": "waterfall"},
        "title": {"type": "string"},
        "x": {"$ref": "#/$defs/axis"},
        "z": {"$ref": "#/$defs/axis"},
        "records": {"type": "array", "items": {"type": "string"}},
        "offsets": {"$ref": "#/$defs/arrayRef"},
        "x_values": {"$ref": "#/$defs/arrayRef"},
        "z_values": {"$ref": "#/$defs/arrayRef"},
        "x_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "z_range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "quantities": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "required": ["value", "label", "records"],
            "properties": {
              "value": {"type": "string"},
              "label": {"type": "string"},
              "records": {"type": "integer", "minimum": 1}
            }
          }
        },
        "quantity": {"type": "string"},
        "page": {
          "type": "object", "required": ["number", "count", "records"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "count": {"type": "integer", "minimum": 1},
            "records": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "view": {"oneOf": [{"$ref": "#/$defs/spectrumView"}, {"$ref": "#/$defs/readingView"}, {"$ref": "#/$defs/shape3dView"}, {"$ref": "#/$defs/waterfallView"}, {"$ref": "#/$defs/matrixView"}]},
    "views": {"type": "array", "items": {"$ref": "#/$defs/view"}},
    "param": {
      "type": "object", "required": ["name", "label", "type"],
      "properties": {
        "name": {"type": "string"},
        "label": {"type": "string"},
        "type": {"enum": ["number", "integer", "enum", "boolean", "string"]},
        "unit": {"type": ["string", "null"]},
        "default": {},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "step": {"type": "number"},
        "options": {
          "type": "array",
          "items": {"type": "object", "required": ["value", "label"],
                    "properties": {"value": {"type": ["string", "number"]}, "label": {"type": "string"}}}
        },
        "options_from": {"type": "string", "pattern": "^(channels|objects:[a-z][a-z0-9_]*(\\|[a-z][a-z0-9_]*)*)$"},
        "in_view": {"type": "boolean"}
      }
    },
    "operation": {
      "type": "object", "required": ["id", "title", "workspace", "accepts", "params", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
        "title": {"type": "string"},
        "workspace": {"enum": ["acquire", "analyze", "modal", "model", "specify", "simulate", "report"]},
        "accepts": {"enum": ["random_run", "modal_model", "modal_run", "project"]},
        "summary": {"type": "string"},
        "params": {"type": "array", "items": {"$ref": "#/$defs/param"}},
        "outputs": {"type": "array", "items": {"enum": ["spectrum", "reading", "shape3d", "waterfall", "matrix"]}}
      }
    },
    "dataset": {
      "type": "object", "required": ["id", "kind", "title"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["random_run", "modal_model", "modal_run"]},
        "title": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "projectObject": {
      "type": "object", "required": ["name", "kind", "groups"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "records": {"type": "integer", "minimum": 0},
        "source": {"$ref": "#/$defs/source"},
        "units_defined": {"type": "boolean"},
        "groups": {"type": "array", "items": {"type": "string"}}
      }
    },
    "project": {
      "type": "object", "required": ["title", "file", "modified", "objects"],
      "properties": {
        "title": {"type": "string"},
        "file": {"type": ["string", "null"]},
        "modified": {"type": "boolean"},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/projectObject"}}
      }
    },
    "projectNewParams": {
      "type": "object", "additionalProperties": false,
      "properties": {"title": {"type": "string", "minLength": 1}}
    },
    "projectOpenParams": {
      "type": "object", "required": ["path"], "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}}
    },
    "projectImportParams": {
      "type": "object", "required": ["path"], "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "units": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "projectSaveParams": {
      "type": "object", "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}, "compress": {"type": "boolean"}}
    },
    "projectResult": {
      "type": "object", "required": ["project"],
      "properties": {"project": {"$ref": "#/$defs/project"}}
    },
    "projectImportResult": {
      "type": "object", "required": ["added", "project"],
      "properties": {
        "added": {"type": "array", "items": {"type": "string"}},
        "project": {"$ref": "#/$defs/project"}
      }
    },
    "projectSaveResult": {
      "type": "object", "required": ["path", "project"],
      "properties": {"path": {"type": "string"}, "project": {"$ref": "#/$defs/project"}}
    },
    "projectProgress": {
      "type": "object", "required": ["done", "total", "path"],
      "properties": {
        "done": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "path": {"type": "string"}
      }
    },
    "catalog": {
      "type": "object", "required": ["operations", "datasets"],
      "properties": {
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "datasets": {"type": "array", "items": {"$ref": "#/$defs/dataset"}}
      }
    },
    "displayEvent": {
      "type": "object", "required": ["run_id", "source", "state", "elapsed_s", "level_db", "views"],
      "properties": {
        "run_id": {"type": "string"},
        "source": {"enum": ["SIM", "HARDWARE"]},
        "state": {"enum": ["idle", "running", "stopped"]},
        "elapsed_s": {"type": "number"},
        "level_db": {"type": "number"},
        "views": {"$ref": "#/$defs/views"},
        "phase": {"type": "string"},
        "outcome": {"enum": ["completed", "operator_stop", "aborted", "held", "fault", null]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "reason": {
      "enum": ["bad_params", "not_controller", "controller_held", "run_active", "not_configured",
               "run_finished", "wrong_state", "manual_mode_required", "not_a_rung",
               "feasibility_exceeded", "override_not_needed", "arm_refused",
               "ni_driver_unavailable", "no_ni_devices", "scan_failed", "devices_absent",
               "mixed_simulated_and_real", "mixed_timing_families", "not_enough_channels",
               "hardware_busy", "stale_revision", "table_invalid", "config_invalid",
               "shaker_record_invalid"]
    },
    "itemReason": {
      "enum": ["duplicate_index", "no_channel_enabled", "zero_sensitivity", "non_positive_range",
               "control_group_gap", "reference_without_control", "unsupported_schema",
               "channel_unbound", "physical_channel_unknown", "physical_channel_wrong_direction",
               "physical_channel_shared", "mixed_timing_families",
               "iepe_without_bias", "bias_on_single_ended", "reference_count_mismatch",
               "drive_channel_present",
               "profile_empty", "first_row_not_anchor", "row_level_ambiguous",
               "frequency_not_positive", "frequency_not_ascending", "psd_negative",
               "alarm_wider_than_abort",
               "n_pts_not_power_of_two", "band_above_grid", "too_few_lines",
               "levels_empty", "levels_not_ascending", "dwell_missing",
               "no_control_channel", "weight_unknown_channel", "weights_sum_not_positive",
               "limit_unknown_channel", "limit_rows_not_ascending",
               "out_of_range"]
    },
    "reportItem": {
      "type": "object", "required": ["reason", "message"], "additionalProperties": false,
      "properties": {
        "reason": {"$ref": "#/$defs/itemReason"},
        "message": {"type": "string", "minLength": 1},
        "channel": {"type": ["integer", "null"], "minimum": 0},
        "row": {"type": "integer", "minimum": 0},
        "field": {"type": "string", "minLength": 1}
      }
    },
    "report": {
      "type": "object", "required": ["errors", "warnings"], "additionalProperties": false,
      "properties": {
        "errors": {"type": "array", "items": {"$ref": "#/$defs/reportItem"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/reportItem"}}
      }
    },
    "source": {"enum": ["SIM", "HARDWARE"]},
    "stationClass": {"enum": ["sim", "ni_simulated", "ni_real"]},
    "controllerSeat": {
      "type": ["object", "null"], "required": ["name", "present"], "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "present": {"type": "boolean"}}
    },
    "sessionState": {
      "type": "object", "required": ["role", "controller", "orphan_s", "heartbeat_s", "timeout_s"],
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["controller", "observer"]},
        "controller": {"$ref": "#/$defs/controllerSeat"},
        "orphan_s": {"type": ["number", "null"], "minimum": 0},
        "heartbeat_s": {"type": "number", "exclusiveMinimum": 0},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sessionClaimParams": {
      "type": "object", "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "lease": {"type": "string", "minLength": 1}}
    },
    "sessionClaimResult": {
      "type": "object", "required": ["role", "lease", "resumed", "heartbeat_s", "timeout_s"],
      "additionalProperties": false,
      "properties": {
        "role": {"const": "controller"},
        "lease": {"type": "string", "minLength": 1},
        "resumed": {"type": "boolean"},
        "heartbeat_s": {"type": "number", "exclusiveMinimum": 0},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sessionReleaseResult": {
      "type": "object", "required": ["role", "orphan_s"], "additionalProperties": false,
      "properties": {"role": {"const": "observer"}, "orphan_s": {"type": ["number", "null"], "minimum": 0}}
    },
    "sessionChanged": {
      "type": "object", "required": ["role", "controller", "orphan_s"], "additionalProperties": false,
      "properties": {
        "role": {"enum": ["controller", "observer"]},
        "controller": {"$ref": "#/$defs/controllerSeat"},
        "orphan_s": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "discoveredChannel": {
      "type": "object", "required": ["id", "label"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string"}}
    },
    "niDevice": {
      "type": "object",
      "required": ["id", "product", "serial", "simulated", "parent", "slot", "timing_family", "inputs", "outputs"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"type": "string"},
        "serial": {"type": "string"},
        "simulated": {"type": "boolean"},
        "parent": {"type": ["string", "null"]},
        "slot": {"type": ["integer", "null"], "minimum": 0},
        "timing_family": {"type": ["string", "null"]},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/discoveredChannel"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/discoveredChannel"}}
      }
    },
    "simStation": {
      "type": "object", "required": ["kind", "title", "available", "class", "inputs", "outputs", "clock"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "sim"},
        "title": {"type": "string"},
        "available": {"const": true},
        "class": {"const": "sim"},
        "inputs": {"type": "integer", "minimum": 1},
        "outputs": {"type": "integer", "minimum": 1},
        "clock": {"const": "shared"}
      }
    },
    "niStation": {
      "type": "object", "required": ["kind", "title", "available", "unavailable", "scanned_unix", "devices"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "ni"},
        "title": {"type": "string"},
        "available": {"type": "boolean"},
        "unavailable": {
          "type": ["object", "null"], "required": ["reason", "message"], "additionalProperties": false,
          "properties": {
            "reason": {"enum": ["ni_driver_unavailable", "no_ni_devices", "scan_failed"]},
            "message": {"type": "string", "minLength": 1}
          }
        },
        "scanned_unix": {"type": ["number", "null"]},
        "devices": {"type": "array", "items": {"$ref": "#/$defs/niDevice"}}
      },
      "if": {"properties": {"available": {"const": false}}},
      "then": {"properties": {"unavailable": {"type": "object"}}},
      "else": {"properties": {"unavailable": {"type": "null"}}}
    },
    "stationSelected": {
      "type": "object",
      "required": ["kind", "devices", "class", "source", "inputs", "outputs", "timing_family"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["sim", "ni"]},
        "devices": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "class": {"$ref": "#/$defs/stationClass"},
        "source": {"$ref": "#/$defs/source"},
        "inputs": {"type": "integer", "minimum": 0},
        "outputs": {"type": "integer", "minimum": 0},
        "timing_family": {"type": ["string", "null"]}
      },
      "allOf": [{"$ref": "#/$defs/sourceFollowsClass"}]
    },
    "sourceFollowsClass": {
      "if": {"required": ["class"], "properties": {"class": {"const": "ni_real"}}},
      "then": {"properties": {"source": {"const": "HARDWARE"}}},
      "else": {"properties": {"source": {"const": "SIM"}}}
    },
    "stationList": {
      "type": "object", "required": ["stations", "selected"], "additionalProperties": false,
      "properties": {
        "stations": {
          "type": "array", "minItems": 2,
          "prefixItems": [{"$ref": "#/$defs/simStation"}, {"$ref": "#/$defs/niStation"}],
          "items": false
        },
        "selected": {"$ref": "#/$defs/stationSelected"}
      }
    },
    "stationSelectParams": {
      "type": "object", "required": ["kind"], "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["sim", "ni"]},
        "devices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "if": {"properties": {"kind": {"const": "ni"}}},
      "then": {"required": ["devices"]}
    },
    "physicalRef": {
      "type": ["object", "null"], "required": ["device", "channel"], "additionalProperties": false,
      "properties": {"device": {"type": "string", "minLength": 1}, "channel": {"type": "string", "minLength": 1}}
    },
    "channelRow": {
      "type": "object",
      "required": ["index", "enabled", "description", "role", "physical", "interface", "iepe_bias_v",
                   "units", "sensitivity_mv_per_eu", "range_max", "polarity", "control_group", "abort"],
      "additionalProperties": false,
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "enabled": {"type": "boolean"},
        "description": {"type": "string"},
        "role": {"enum": ["control", "monitor", "drive", "reference"]},
        "physical": {"$ref": "#/$defs/physicalRef"},
        "interface": {"enum": ["single_ended", "iepe"]},
        "iepe_bias_v": {"type": ["number", "null"]},
        "units": {"type": "string", "minLength": 1},
        "sensitivity_mv_per_eu": {"type": "number"},
        "range_max": {"type": "number"},
        "polarity": {"enum": ["positive", "negative"]},
        "control_group": {"type": ["integer", "null"], "minimum": 0},
        "abort": {
          "type": "object", "required": ["accel_g", "velocity_ips", "displacement_mil"],
          "additionalProperties": false,
          "properties": {
            "accel_g": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "velocity_ips": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "displacement_mil": {"type": ["number", "null"], "exclusiveMinimum": 0}
          }
        }
      }
    },
    "channelTable": {
      "type": "object", "required": ["revision", "channels", "report"], "additionalProperties": false,
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "channels": {"type": "array", "items": {"$ref": "#/$defs/channelRow"}},
