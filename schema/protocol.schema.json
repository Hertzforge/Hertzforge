                   "control_rms_g", "reference_rms_g", "control_error_db", "drive_rms_v", "lines",
                   "channels", "alarms", "plots"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "class": {"$ref": "#/$defs/stationClass"},
        "state": {"enum": ["running", "review", "stopping", "finished"]},
        "phase": {"$ref": "#/$defs/runPhase"},
        "mode": {"enum": ["auto", "manual"]},
        "elapsed_s": {"type": "number", "minimum": 0},
        "level_db": {"type": ["number", "null"]},
        "commanded_db": {"type": ["number", "null"]},
        "at_level_s": {"type": ["number", "null"], "minimum": 0},
        "remaining_at_level_s": {"type": ["number", "null"], "minimum": 0},
        "level_s": {"type": ["number", "null"], "minimum": 0},
        "loop": {"type": "integer", "minimum": 0},
        "control_rms_g": {"type": ["number", "null"], "minimum": 0},
        "reference_rms_g": {"type": ["number", "null"], "minimum": 0},
        "control_error_db": {"type": ["number", "null"]},
        "drive_rms_v": {"type": ["number", "null"], "minimum": 0},
        "lines": {
          "type": "object", "required": ["in_band", "alarm", "abort"], "additionalProperties": false,
          "properties": {
            "in_band": {"type": "integer", "minimum": 0},
            "alarm": {"type": "integer", "minimum": 0},
            "abort": {"type": "integer", "minimum": 0}
          }
        },
        "channels": {"type": "array", "items": {"$ref": "#/$defs/liveChannel"}},
        "alarms": {"type": "array", "items": {"$ref": "#/$defs/alarm"}},
        "plots": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/dataPlot"}}
      },
      "allOf": [{"$ref": "#/$defs/sourceFollowsClass"}]
    },
    "logEntry": {
      "type": "object", "required": ["seq", "at_unix", "kind", "text"], "additionalProperties": false,
      "properties": {
        "seq": {"type": "integer", "minimum": 0},
        "at_unix": {"type": "number"},
        "kind": {"enum": ["state", "feasibility", "override", "station", "gate", "level", "alarm",
                          "overload", "trip", "note"]},
        "text": {"type": "string"}
      }
    },
    "randomLogResult": {
      "type": "object", "required": ["entries", "next"], "additionalProperties": false,
