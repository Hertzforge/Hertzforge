          "items": false
        }
      },
      "allOf": [{"$ref": "#/$defs/sourceFollowsClass"}]
    },
    "quantity": {"enum": ["control", "drive", "response", "time", "coherence", "readings"]},
    "channelSelector": {
      "oneOf": [{"enum": ["all", "control", "limited"]},
                {"type": "array", "items": {"type": "integer", "minimum": 0}}]
    },
    "subscribePlot": {
      "type": "object", "required": ["id", "quantity"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "quantity": {"$ref": "#/$defs/quantity"},
        "channels": {"oneOf": [{"$ref": "#/$defs/channelSelector"}, {"type": "null"}]},
        "points": {"type": ["integer", "null"], "minimum": 64, "maximum": 8192}
      },
      "allOf": [
        {"if": {"properties": {"quantity": {"enum": ["control", "drive", "coherence", "readings"]}}},
         "then": {"properties": {"channels": {"type": "null"}, "points": {"type": "null"}}}},
        {"if": {"properties": {"quantity": {"const": "response"}}},
         "then": {"properties": {"points": {"type": "null"}}}}
      ]
    },
    "randomSubscribeParams": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "default": {"type": ["boolean", "null"]},
        "rate_hz": {"type": ["number", "null"], "minimum": 0.5, "maximum": 10},
        "plots": {"oneOf": [{"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/subscribePlot"}},
                            {"type": "null"}]}
      },
      "oneOf": [
        {"required": ["default"], "properties": {"default": {"const": true}, "plots": {"type": "null"}}},
        {"required": ["plots"], "properties": {"default": {"enum": [false, null]}, "plots": {"type": "array"}}}
      ]
    },
    "randomSubscribeResult": {
      "type": "object", "required": ["default", "rate_hz", "plots", "quantities"],
      "additionalProperties": false,
      "properties": {
        "default": {"type": "boolean"},
        "rate_hz": {"type": "number", "minimum": 0.5, "maximum": 10},
        "plots": {"oneOf": [{"type": "array", "items": {"$ref": "#/$defs/subscribePlot"}}, {"type": "null"}]},
        "quantities": {"type": "array", "items": {"$ref": "#/$defs/quantity"}}
      },
      "if": {"properties": {"default": {"const": true}}},
      "then": {"properties": {"plots": {"type": "null"}}},
      "else": {"properties": {"plots": {"type": "array"}}}
    },
    "dataPlot": {
      "type": "object", "required": ["id", "quantity", "channels", "views"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "quantity": {"$ref": "#/$defs/quantity"},
        "channels": {"oneOf": [{"type": "array", "items": {"type": "integer", "minimum": 0}}, {"type": "null"}]},
        "views": {"type": "array", "items": {"$ref": "#/$defs/view"}}
      },
      "if": {"properties": {"quantity": {"enum": ["response", "time"]}}},
      "then": {"properties": {"channels": {"type": "array"}}},
      "else": {"properties": {"channels": {"type": "null"}, "views": {"minItems": 1, "maxItems": 1}}}
