            "properties": {"channel": {"type": "integer", "minimum": 0}, "weight": {"type": "number"}}
          }
        },
        "control_dof": {"type": "number"},
        "damping": {"type": "number"},
        "max_lines_out": {"type": "integer"},
        "max_loops_out": {"type": "integer"},
        "max_sigma": {"type": ["number", "null"]},
        "drive_ceiling_vrms": {"type": "number"},
        "drive_abort_vrms": {"type": ["number", "null"]},
        "coherence_floor": {"type": "number"},
        "review_after_sysid": {"type": "boolean"},
        "pretest": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "averages": {"type": "integer"},
            "level_db": {"type": "number"},
            "max_vrms": {"type": ["number", "null"]},
            "start_vrms": {"type": "number"},
            "shaped": {"type": "boolean"}
          }
        },
        "soft_start_db": {"type": "number"},
