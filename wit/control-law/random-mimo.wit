package hertzforge:control-law@0.1.0;

// The multiple-input, multiple-output (MIMO) Random interface: a law that
// turns the latest measurement into the next drive spectral density matrix
// for `drives` outputs controlling `controls` responses.
//
// Conventions (docs/control-law-spec.md, section 7):
//
// - Spectral matrix. A spectral density matrix (SDM) is
//   G = lim (1/T) E[X X^H] per line, with X the spectrum under the
//   negative-exponent forward transform, X[k] = sum_n x[n] exp(-j 2 pi k n / N).
//   The off-diagonal entry (i, j) is E[X_i conj(X_j)], its angle the phase of
//   channel i minus the phase of channel j, and a response Y = H X has
//   G_yy = H G_xx H^H with H response over drive and H^H its conjugate
//   transpose; the response-to-drive cross spectrum has entries
//   E[Y_c conj(V_d)], so H = S_yv inv(S_vv). Rattlesnake and SDynPy hold this
//   form, so a law ported from either needs no conjugation. It is the complex
//   conjugate of the Bendat and Piersol definition (G_xy = E[X* Y]) that
//   Hertzforge's analysis files and much other software hold. The core forms
//   this one directly (its estimator conjugates the workspace FFT's
//   positive-exponent spectra) and converts at every file crossing; a law
//   never converts.
// - One-sided. SDMs are one-sided: the integral of a power spectral density
//   over frequency is the signal's variance.
// - One call covers the whole grid: every line, in line order. Line `k` is at
//   `k * df-hz`. Lines outside the band carry no drive.
// - A complex value is a record of two f64, `re` and `im`.
// - A rectangular matrix stack is passed in full, row-major within a line,
//   lines one after another: element (r, c) of line l is
//   `data[(l * rows + r) * cols + c]`.
// - A Hermitian matrix stack is passed packed: the upper triangle of each
//   line, row-major, lines one after another. For r <= c the element (r, c)
//   of line l is `data[l * n * (n + 1) / 2 + r * (2 * n - r + 1) / 2 + (c - r)]`;
//   an element below the diagonal is the conjugate of its mirror. Diagonal
//   elements are real: their imaginary part is zero.
// - Units. A control response SDM is in the control channel's units squared
//   per hertz (EU^2/Hz); a drive SDM in volts squared per hertz (V^2/Hz); an
//   FRF in response units per volt (EU/V), controls by drives.
// - Level. Everything a law sees and returns is at full level (0 dB): the
//   reference is the full-level specification, the measured response has
//   been referred to its full-level equivalent, and the drive a law returns
//   is the full-level drive. The controller applies the level schedule; a law
//   never sees the level and cannot change it.
// - Spaces. `controls` are the control channels the reference is written in
//   (physical channels, or virtual degrees of freedom after the response
//   transformation); `drives` are the drives the law commands (physical
//   outputs, or virtual drives before the drive transformation).

/// Types for multiple-output Random.
interface mimo-types {
    use types.{band, manifest};

    record complex {
        re: f64,
        im: f64,
    }

    /// One complex matrix per line, stacked and passed in full: `lines`
    /// matrices of `rows` by `cols`, row-major within a line, line after
    /// line. `data` holds `lines * rows * cols` values.
    record matrix-stack {
        lines: u32,
        rows: u32,
        cols: u32,
        data: list<complex>,
    }

    /// One Hermitian `n` by `n` matrix per line, packed: the upper triangle
    /// of each line, row-major, line after line. `data` holds
    /// `lines * n * (n + 1) / 2` values; every diagonal value is real.
    record hermitian-stack {
        lines: u32,
        n: u32,
        data: list<complex>,
    }

    /// The control-to-drive shapes a law supports.
    enum mimo-shape {
        /// As many control channels as drives.
        square,
        /// More control channels than drives (least squares).
        more-controls-than-drives,
        /// Fewer control channels than drives (minimum norm).
        fewer-controls-than-drives,
    }

    /// The optional inputs a law may declare it needs. The controller
    /// passes only the ones declared; the others arrive as `none`.
    enum mimo-input {
        /// The drive SDM of the last loop as it was played, after the
        /// controller's limits, at full level: drives by drives.
        last-drive,
        /// This loop's measured response-to-drive cross spectrum, controls
        /// by drives, so a law can adapt its own plant estimate.
        response-drive-csd,
        /// System identification: the control response SDM, controls by
        /// controls.
        sysid-response,
        /// System identification: the drive SDM, drives by drives.
        sysid-drive,
        /// System identification: the control response SDM with the drives
        /// off (the noise floor), controls by controls.
        sysid-noise,
    }

    /// The layout of one declared diagnostic's values.
    enum diagnostic-kind {
        /// One number for the loop.
        scalar,
        /// One number per line of the grid: `lines` values.
        per-line,
        /// One number per control channel per line, line after line:
        /// `lines * controls` values.
        per-control-line,
        /// One number per drive per line, line after line:
        /// `lines * drives` values.
        per-drive-line,
    }

    /// The layout of the diagnostic declared under `key`.
    record diagnostic-layout {
        key: string,
        kind: diagnostic-kind,
    }

    /// What a multiple-output law says about itself. Read once, when the law
    /// file is loaded.
    record mimo-manifest {
        /// Name, version, author, summary, parameters and diagnostics, as
        /// for every law. A per-channel parameter holds one value per
        /// control channel.
        law: manifest,
        /// The shapes the law supports. The controller refuses a test of
        /// another shape. At least one, each at most once.
        shapes: list<mimo-shape>,
        /// The optional inputs the law reads, each at most once.
        needs: list<mimo-input>,
        /// The layout of every diagnostic `law` declares, each exactly once.
        diagnostic-layouts: list<diagnostic-layout>,
    }

    /// The alarm and abort lines of every control channel, as power spectral
    /// densities at full level (EU^2/Hz): `lines * controls` values each,
    /// line after line. NaN means no line there.
    record tolerance-lines {
        alarm-upper: list<f64>,
        alarm-lower: list<f64>,
        abort-upper: list<f64>,
        abort-lower: list<f64>,
    }

    /// What a multiple-output law is built for: fixed for the run.
    record mimo-setup {
        /// Control channels (or virtual degrees of freedom).
        controls: u32,
        /// Drives (or virtual drives).
        drives: u32,
        /// Lines on the grid.
        lines: u32,
        /// Line spacing, Hz.
        df-hz: f64,
        /// The controlled band.
        band: band,
        /// The reference SDM at full level, controls by controls.
        reference: hermitian-stack,
        /// The alarm and abort lines per control channel.
        tolerances: tolerance-lines,
    }

    /// Everything a multiple-output law sees on one loop, at full level.
    record mimo-inputs {
        /// The reference SDM at full level, controls by controls.
        reference: hermitian-stack,
        /// The alarm and abort lines per control channel, so a law can
        /// weight its effort by where the tolerance is tight.
        tolerances: tolerance-lines,
        /// The measured control response SDM referred to full level,
        /// controls by controls. At the seed this is the system
        /// identification response.
        response: hermitian-stack,
        /// Statistical degrees of freedom of `response`.
        response-dof: f64,
        /// The plant estimate the controller is using (held from system
        /// identification or updated each loop, by the operator's choice),
        /// controls by drives.
        frf: matrix-stack,
        /// Multiple coherence of each control channel on all drives, 0 to 1:
        /// `lines * controls` values, line after line.
        multiple-coherence: list<f64>,
        /// Line spacing, Hz.
        df-hz: f64,
        /// The controlled band.
        band: band,
        /// 0 for the seed, then 1, 2, ... for each iteration.
        loop-index: u64,
        /// Present only when the manifest declares `last-drive`.
        last-drive: option<hermitian-stack>,
        /// Present only when the manifest declares `response-drive-csd`: this
        /// loop's measured response-to-drive cross spectrum, controls by
        /// drives per line, entry (c, d) = E[Y_c conj(V_d)], so a law can
        /// adapt its own plant estimate as H = S_yv inv(S_vv).
        response-drive-csd: option<matrix-stack>,
        /// Present only when the manifest declares `sysid-response`.
        sysid-response: option<hermitian-stack>,
        /// Present only when the manifest declares `sysid-drive`.
        sysid-drive: option<hermitian-stack>,
        /// Present only when the manifest declares `sysid-noise`.
        sysid-noise: option<hermitian-stack>,
    }

    /// The values of one diagnostic, in its declared layout.
    variant diagnostic-data {
        scalar(f64),
        per-line(list<f64>),
        per-control-line(list<f64>),
        per-drive-line(list<f64>),
    }

    /// One diagnostic's values for this loop, under a declared key.
    record mimo-diagnostic {
        key: string,
        data: diagnostic-data,
    }

    /// One loop's result.
    record mimo-outputs {
        /// The next full-level drive SDM, drives by drives, V^2/Hz: finite,
        /// Hermitian (real diagonal), positive semi-definite on every line,
        /// and zero on every line outside the band.
        drive: hermitian-stack,
        /// The law's declared diagnostics, each at most once, finite, in its
        /// declared layout. Shown and recorded; never relied on for
        /// protection.
        diagnostics: list<mimo-diagnostic>,
    }
}

/// The multiple-output law resource.
interface random-mimo-law {
    use types.{param};
    use mimo-types.{mimo-setup, mimo-inputs, mimo-outputs};

    resource law {
        /// Build the law for a run. `params` holds every declared parameter,
        /// already checked against the manifest, in manifest order; values
        /// the operator left out carry their defaults. An error refuses the
        /// run with the given reason.
        constructor(setup: mimo-setup, params: list<param>) -> result<law, string>;

        /// Called once after system identification, with the identification
        /// response as `response`: return the first full-level drive.
        seed: func(inputs: mimo-inputs) -> result<mimo-outputs, string>;

        /// One control loop: return the next full-level drive from the
        /// latest measurement.
        iterate: func(inputs: mimo-inputs) -> result<mimo-outputs, string>;
    }
}

/// The world a multiple-output Random law file implements.
world random-mimo {
    use mimo-types.{mimo-manifest};

    /// The law's name, version, parameters, diagnostics, shapes and needs.
    export describe: func() -> mimo-manifest;

    export random-mimo-law;
}
